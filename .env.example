# Copy to .env (repo root or backend/).
#
# Only the BOOTSTRAP section is required outside the app. Everything else can be set in the
# hub's Settings page (stored encrypted in the database); values here act as defaults.

# --- Bootstrap (environment only) -----------------------------------------------------------
# Postgres for tasks, settings, activities, snapshots and paused agent runs.
# `docker compose up -d postgres` provides one on localhost:5442. Empty = SQLite (dev only).
DATABASE_URL=postgresql://hub:hub_dev_only@127.0.0.1:5442/hub
# Fernet key that encrypts secrets at rest. Empty = generated once into backend/data/secret.key.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
HUB_SECRET_KEY=
# Optional: sets the admin password on first start. If empty, the server logs a one-time
# setup code and you create the password in the browser.
ADMIN_PASSWORD=
COOKIE_SECURE=false          # true when served over HTTPS

# --- Defaults for runtime settings (editable in Settings) -------------------------------------
MARKETO_MODE=demo            # demo = in-memory sandbox; live = your instance
# LaunchPoint credentials, shared by REST/Bulk (https://<munchkin>.mktorest.com) and the
# MCP server (sent as X-Marketo-Munchkin-Id / X-Marketo-Client-Id / X-Marketo-Client-Secret).
MARKETO_MUNCHKIN_ID=         # e.g. 123-ABC-456 (Admin > Munchkin)
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
MARKETO_MCP_URL=https://marketo-mcp.adobe.io/mcp

# LLM router: provider/model per tier. anthropic/* uses the Anthropic SDK; other providers
# (openai/, gemini/, azure/, ollama/) go through LiteLLM.
LLM_FAST_MODEL=anthropic/claude-haiku-5-5
LLM_STANDARD_MODEL=anthropic/claude-sonnet-5-5
LLM_STRONG_MODEL=anthropic/claude-opus-5-5
LLM_ROUTING=auto             # auto escalates big/high-stakes prompts and steps down near budget
LLM_DAILY_BUDGET_USD=0       # 0 = no cap
ANTHROPIC_API_KEY=

# Knowledge search: embeddings through LiteLLM (Anthropic has no embeddings model).
# Empty = keyword search. e.g. voyage/voyage-3.5, openai/text-embedding-3-small
EMBEDDING_MODEL=
# VOYAGE_API_KEY=

# Activity ingestion: Marketo Data Streams via Adobe I/O Events journal, else REST polling.
ACTIVITY_SOURCE=auto
# ADOBE_ORG_ID=
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# DATASTREAMS_JOURNAL_URL=

# Azure Data Lake Storage Gen2 archive of raw events + daily snapshots
ADLS_ENABLED=false
# ADLS_CONNECTION_STRING=
# ADLS_FILESYSTEM=marketo-agent-hub

AGENT_PACING_S=1.5
